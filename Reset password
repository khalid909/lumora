const $ = s => document.querySelector(s);
const $$ = s => [...document.querySelectorAll(s)];
let lang; try { lang = JSON.parse(localStorage.getItem('lm_lang')); } catch {}
if (!I[lang]) lang = (navigator.language || 'ar').slice(0, 2);
if (!I[lang]) lang = 'ar';
const t = k => I[lang][k] ?? I.en[k] ?? k;
try { const th = JSON.parse(localStorage.getItem('lm_theme')); if (th === 'dark' || th === 'light') document.documentElement.setAttribute('data-theme', th); } catch {}
function applyI18n() {
  document.documentElement.lang = lang; document.documentElement.dir = lang === 'ar' ? 'rtl' : 'ltr';
  $$('[data-i]').forEach(e => { e.textContent = t(e.dataset.i); });
  $$('[data-ph]').forEach(e => { e.placeholder = t(e.dataset.ph); });
  $$('[data-al]').forEach(e => { e.setAttribute('aria-label', t(e.dataset.al)); });
  $$('[data-lang]').forEach(b => b.setAttribute('aria-pressed', b.dataset.lang === lang));
  document.title = t(document.body.dataset.title) + ' — Lumora';
}
document.addEventListener('click', e => {
  const b = e.target.closest('[data-lang]'); if (b) { lang = b.dataset.lang; try { localStorage.setItem('lm_lang', JSON.stringify(lang)); } catch {} applyI18n(); if (window.onLang) window.onLang(); }
  const eye = e.target.closest('.eye'); if (eye) { const inp = document.getElementById(eye.dataset.for); inp.type = inp.type === 'password' ? 'text' : 'password'; }
});
const rel = f => new URL(f, location.href).href;
/* يسمح فقط بروابط داخلية من نوع page.html — يمنع التحويل لمواقع خارجية (open redirect) */
function safeNext(def) {
  const n = new URLSearchParams(location.search).get('next') || '';
  return (/^(?![a-z][a-z0-9+.-]*:|\/\/|\\)[\w\-\/.]+\.html(\?[\w=&%.\-]*)?(#[\w\-]*)?$/i.test(n) && !n.includes('..')) ? n : def;
}
const validEmail = s => /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(s);
function say(el, text, kind) { el.className = 'msg' + (kind ? ' ' + kind : ''); el.textContent = text || ''; if (!text) el.style.display = 'none'; else el.style.display = ''; }
function errText(e) {
  const m = String((e && (e.message || e.error_description)) || '') + ' ' + String((e && (e.code || e.status)) || '');
  if (/invalid login|invalid_credentials/i.test(m)) return t('bad_login');
  if (/not confirmed|email_not_confirmed/i.test(m)) return t('unconfirmed');
  if (/rate.?limit|too many|429|after \d+ seconds/i.test(m)) return t('rate');
  if (/already registered|user_already_exists/i.test(m)) return t('exists');
  if (/weak|at least \d+ char|password should/i.test(m)) return t('weak');
  if (/fetch|network|failed to/i.test(m)) return t('net');
  return t('generic');
}
function strength(p) {
  let s = 0; if (p.length >= 8) s++; if (p.length >= 12) s++; if (/[a-z]/.test(p) && /[A-Z]/.test(p)) s++; if (/\d/.test(p)) s++; if (/[^\w\s]/.test(p)) s++;
  if (p.length < 8) s = Math.min(s, 1);
  return Math.min(s, 4);
}
function bindMeter(input, bar, label) {
  const cols = ['#c62828', '#e08a00', '#c9a400', '#2f9e44', '#0a7a3d'], names = ['pw_weak', 'pw_weak', 'pw_ok', 'pw_good', 'pw_strong'];
  const upd = () => { const v = input.value, s = v ? strength(v) : -1; bar.style.width = v ? (s + 1) * 20 + '%' : '0'; bar.style.background = cols[Math.max(s, 0)]; label.textContent = v ? t(names[s]) : ''; };
  input.addEventListener('input', upd); return upd;
}
function cooldown(btn, label, secs, after) {
  let n = secs; btn.disabled = true;
  const tick = () => { if (n <= 0) { btn.disabled = false; btn.textContent = after(); return; } btn.textContent = label() + ' ' + n + 's'; n--; setTimeout(tick, 1000); };
  tick();
}
const sb = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY, { auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true, flowType: 'implicit' } });
function homeFor(user) {
  const a = user && user.user_metadata && user.user_metadata.account_type;
  return a === 'seller' ? HOME.seller : HOME.customer;
}


