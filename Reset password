    if (ready) return;
    const { data } = await sb.auth.getSession();
    if (data && data.session && /type=recovery/.test(location.hash + location.search)) { ready = true; show('f'); } else if (!ready) show('bad');
  }, 3500);
}
f.addEventListener('submit', async e => {
  e.preventDefault(); say(m, '');
  const p = $('#pass').value;
  if (p.length < 8) return say(m, t('weak'), 'err');
  if (p !== $('#pass2').value) return say(m, t('mismatch'), 'err');
  const b = $('#go'); b.disabled = true;
  try {
    const { error } = await sb.auth.updateUser({ password: p });
    if (error) { say(m, errText(error), 'err'); b.disabled = false; return; }
    say(m, t('reset_done'), 'ok');
    try { await sb.auth.signOut(); } catch {}
    setTimeout(() => location.replace('login.html'), 1800);
  } catch (er) { say(m, errText(er), 'err'); b.disabled = false; }
});

applyI18n();
